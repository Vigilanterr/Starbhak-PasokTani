// =============================================================================
// Pasok Tani: MVP database schema
// Target: PostgreSQL 18
// Rationale, trade-offs and patterns: docs/database/documentation.md
//
// Conventions
// - Identifiers: English, lowercase snake_case. The API layer maps them to the
//   Indonesian field names used by the frontend (e.g. stock -> stok).
// - Primary keys: uuid generated by the PG18 built-in uuidv7() (time-ordered).
//   Reference tables (regions) use official Kemendagri codes as natural keys.
//   users.id is the exception: it equals neon_auth.user.id (managed by Neon Auth).
// - Stack: Neon (Postgres 18) + managed Neon Auth (Google OAuth only),
//   Node.js backend (Express + TypeScript, node-postgres), Upstash Redis, Cloudinary.
// - Outside Postgres: sessions/OAuth (Neon Auth), images (Cloudinary, only ids
//   and metadata here), counters/cache/rate limits/presence/pub-sub (Redis).
// - Money: bigint, whole Rupiah (IDR has no minor unit in practice).
// - Quantities: numeric(12,3) in the product's own unit (kg, bunch, ...).
// - Rates: numeric(5,2) percent (3.00 = 3%).
// - Time: timestamptz for instants, date for calendar days (harvest/expiry).
// - Every FK column is indexed (Postgres does not do it automatically).
// - Things DBML cannot express (partial/GIN/GiST indexes, generated columns,
//   triggers, partitioning, WITHOUT OVERLAPS, RLS) are written in notes and
//   must be implemented in the migration SQL.
// =============================================================================

Project pasok_tani {
  database_type: 'PostgreSQL'
  Note: '''
  Agricultural marketplace for West Java (farmers -> households and UMKM).
  Required extensions: pg_trgm, unaccent, postgis, btree_gist.
  uuidv7() is built into PostgreSQL 18 (no extension needed).
  Hosted on Neon. Schema neon_auth is owned by Neon Auth: never migrate it.
  Scheduled jobs run in the Node backend (not pg_cron) so they survive scale-to-zero.
  '''
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum user_role {
  consumer [note: 'Household buyer']
  umkm [note: 'Small-business buyer (food stall, caterer); no documents required']
  farmer
  admin
}

enum user_status {
  active
  suspended
  deleted
}

enum verification_status {
  unverified
  pending
  approved
  rejected
}

enum product_unit {
  kg
  bunch [note: 'ikat']
  piece [note: 'buah']
  pack [note: 'pak']
  liter
}

enum product_status {
  draft
  active
  inactive [note: 'Deactivated by the farmer']
  banned [note: 'Taken down by admin moderation']
}

enum batch_status {
  active
  depleted [note: 'on_hand_qty reached 0']
  expired [note: 'Past expires_on; public stock reduced, can be undone until expiry_undo_until']
  voided
}

enum stock_movement_type {
  stock_in [note: 'New batch / Add New Stock / wait-list harvest']
  sale [note: 'Reservation converted after payment']
  cancel_restore [note: 'Order cancelled or refunded before shipping']
  return_restock [note: 'Farmer chose to restock a returned item']
  expiry_reduction
  expiry_undo
  manual_adjustment [note: 'Damaged, lost, sold offline; reason required']
}

enum reservation_status {
  active
  converted [note: 'Payment confirmed; became a sale movement']
  released [note: 'Payment expired or checkout cancelled']
}

enum waitlist_status {
  planting_scheduled
  planted
  harvest_delayed
  harvest_early
  harvest_failed
  ready_to_harvest [note: 'Wait list ends; product opens for purchase']
}

enum harvest_schedule_type {
  exact_date
  date_range
  not_set [note: 'Shown as "Estimate not available"']
}

enum waitlist_event_type {
  status_change
  schedule_change
  field_photo
  note
}

enum commitment_status {
  active [note: 'Minimum funds held in escrow']
  awaiting_remainder [note: 'Harvest available; remainder due within 48 hours']
  allocated [note: 'Stock allocated, order created']
  partially_allocated [note: 'Harvest covered only part of the range']
  unallocated_refunded [note: 'No stock left for this holder; minimum funds refunded']
  cancelled [note: 'Manual cancellation by the buyer (penalty may apply)']
  harvest_failed_refunded
}

enum cart_kind {
  temporary [note: 'Default cart; cleared after checkout']
  recipe [note: 'Recipe Cart group; kept after checkout']
}

enum order_status {
  awaiting_payment
  confirmed
  processing
  shipped
  completed
  cancelled
}

enum order_item_source {
  direct
  commitment
  recipe_cart
}

enum escrow_status {
  not_funded
  held
  disputed [note: 'Complaint open; auto-release paused']
  released
  refunded
  partially_refunded
}

enum delivery_method {
  courier_regular
  courier_instant
  self_delivery
  pickup
}

enum payment_method {
  qris
  virtual_account
  wallet [note: 'Platform wallet balance (refunds)']
}

enum payment_purpose {
  checkout
  commitment_hold
  commitment_remainder
}

enum payment_status {
  pending
  paid
  expired
  failed
  refunded
}

enum ledger_account_type {
  buyer_wallet
  farmer_balance
  escrow
  platform_revenue
  payment_clearing [note: 'Money received from the payment gateway, not yet allocated']
  payout_clearing [note: 'Money sent to bank, awaiting gateway confirmation']
}

enum ledger_txn_kind {
  payment_received
  escrow_hold
  escrow_release
  commission
  service_fee
  penalty
  refund
  payout
  adjustment
}

enum refund_status {
  pending
  completed
  failed
}

enum payout_status {
  requested
  processing
  completed
  failed
  cancelled
}

enum complaint_reason {
  damaged
  not_as_described
  rotten
  missing_items
  other
}

enum complaint_status {
  open
  farmer_responded
  under_mediation
  resolved_full_refund
  resolved_partial_refund
  rejected
}

enum report_status {
  open
  reviewing
  actioned
  dismissed
}

enum moderation_status {
  published
  hidden
}

enum media_kind {
  product_photo
  waitlist_photo
  review_photo
  complaint_evidence
  chat_attachment
  avatar
  ktp [note: 'Private: Cloudinary authenticated delivery, signed URLs only']
  land_photo [note: 'Private: Cloudinary authenticated delivery, signed URLs only']
}

enum media_status {
  pending [note: 'Signed upload issued, Cloudinary webhook not received yet']
  ready
  rejected [note: 'Failed moderation or validation']
  deleted [note: 'Destroyed on Cloudinary; row kept for history']
}

enum notification_frequency {
  instant
  daily_digest
}

enum notification_category {
  order
  payment
  waitlist
  product_subscription
  chat
  review
  system
}

// -----------------------------------------------------------------------------
// Regions (West Java reference data)
// -----------------------------------------------------------------------------

Table regencies {
  code text [pk, note: 'Kemendagri code, e.g. 32.04 (Kab. Bandung). Province 32 = Jawa Barat']
  name text [not null]
  slug text [unique, not null, note: 'URL filter value, e.g. kabupaten-bandung']
  is_city boolean [not null, default: false]
  centroid "geography(Point,4326)"
  Note: 'Seeded reference data. MVP covers province 32 only.'
}

Table districts {
  code text [pk, note: 'Kemendagri code, e.g. 32.04.01']
  regency_code text [not null, ref: > regencies.code]
  name text [not null]
  centroid "geography(Point,4326)"

  indexes {
    regency_code
  }
}

// -----------------------------------------------------------------------------
// Identity and accounts
// -----------------------------------------------------------------------------

Table neon_auth.user {
  id uuid [pk, note: 'Better Auth user id (random uuid)']
  name text
  email text [unique]
  "emailVerified" boolean
  image text [note: 'Google profile picture URL']
  role text [note: 'Better Auth admin role; NOT our marketplace role']
  banned boolean
  "createdAt" timestamptz
  "updatedAt" timestamptz
  Note: '''
  MANAGED BY NEON AUTH. Shown for the FK only; do not create or alter it in
  migrations. Sessions, Google OAuth accounts and verification live in
  neon_auth.session / account / verification and are not used by the app directly.
  '''
}

Table users {
  id uuid [pk, note: 'Same value as neon_auth.user.id; row created on first sign-in (onboarding)']
  full_name text [not null, note: 'Prefilled from Google name, editable']
  phone text [note: 'E.164; required before first checkout / shipment']
  role user_role [not null, note: 'Chosen at onboarding: consumer, umkm or farmer. Admins seeded.']
  status user_status [not null, default: 'active']
  avatar_media_id uuid [note: 'Custom avatar; NULL = use neon_auth.user.image']
  onboarded_at timestamptz [note: 'Role and required profile fields completed']
  last_seen_at timestamptz [note: 'Flushed from Redis presence, not written per request']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz [note: 'Soft delete; PII scrubbed by a job (UU PDP)']

  indexes {
    (role, created_at)
    avatar_media_id
  }
  Note: 'Email is read from neon_auth.user (single source of truth). Sessions are handled by Neon Auth.'
}

Table media_assets {
  id uuid [pk, default: `uuidv7()`]
  owner_id uuid [not null, ref: > users.id, note: 'Uploader']
  kind media_kind [not null]
  status media_status [not null, default: 'pending']
  cloudinary_public_id text [unique, not null, note: 'e.g. pasok-tani/products/<uuid>']
  cloudinary_version bigint [note: 'Cache-busting version from the upload response']
  delivery_type text [not null, default: 'upload', note: 'upload (public) | authenticated (KTP, land photo)']
  format text [note: 'Original format; delivered with f_auto,q_auto']
  width integer
  height integer
  bytes integer
  taken_on date [note: 'Photo/harvest date shown as the freshness label']
  created_at timestamptz [not null, default: `now()`]
  ready_at timestamptz

  indexes {
    (owner_id, created_at)
    (status, created_at) [note: 'Cleanup job: pending rows older than 24 h are destroyed']
  }
  Note: '''
  Images live on Cloudinary; only ids and metadata are stored here.
  Browser uploads directly with a backend-signed upload; the Cloudinary webhook marks
  the row ready. Compression and resizing are Cloudinary transformations, not stored files.
  '''
}

Table addresses {
  id uuid [pk, default: `uuidv7()`]
  user_id uuid [not null]
  label text [not null, note: 'e.g. Rumah, Warung']
  recipient_name text [not null]
  phone text [not null]
  regency_code text [not null, ref: > regencies.code]
  district_code text [not null, ref: > districts.code]
  street text [not null]
  postal_code text
  location "geography(Point,4326)" [note: 'Pin from the map; used for distance and shipping cost']
  notes text
  is_default boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    user_id
    regency_code
    district_code
  }
  Note: 'Partial unique index: (user_id) WHERE is_default (at most one default address).'
}

Table notification_preferences {
  user_id uuid [not null]
  category notification_category [not null]
  web_enabled boolean [not null, default: true]
  frequency notification_frequency [not null, default: 'instant']

  indexes {
    (user_id, category) [pk]
  }
  Note: 'Missing row = default (all on, instant). Rows exist only once a user changes something.'
}

Table push_subscriptions {
  id uuid [pk, default: `uuidv7()`]
  user_id uuid [not null]
  endpoint text [unique, not null, note: 'Web Push endpoint URL']
  p256dh text [not null]
  auth text [not null]
  user_agent text
  created_at timestamptz [not null, default: `now()`]
  last_success_at timestamptz

  indexes {
    user_id
  }
}

// -----------------------------------------------------------------------------
// Farmers
// -----------------------------------------------------------------------------

Table farmer_profiles {
  user_id uuid [pk, note: '1:1 with users where role = farmer']
  shop_name text [not null]
  slug text [unique, not null]
  description text
  regency_code text [not null, ref: > regencies.code]
  district_code text [not null, ref: > districts.code]
  address_line text [note: 'Required before the first order ships']
  location "geography(Point,4326)" [note: 'Farm location; GiST index for "near me"']
  land_area_ha numeric(8,2)
  verification_status verification_status [not null, default: 'unverified']
  verified_at timestamptz
  auto_cancel_after_hours smallint [note: 'NULL = off; else 12, 24 or 48']
  self_delivery_enabled boolean [not null, default: false]
  self_delivery_fee bigint [note: 'IDR, set by the farmer']
  pickup_enabled boolean [not null, default: false]
  // Denormalized counters, refreshed by triggers/jobs (see documentation 4.8)
  rating_avg numeric(3,2) [not null, default: 0]
  rating_count integer [not null, default: 0]
  completed_order_count integer [not null, default: 0]
  avg_response_minutes integer [note: 'Computed from messages; used by Fast Response badge']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  checks {
    `auto_cancel_after_hours IS NULL OR auto_cancel_after_hours IN (12, 24, 48)` [name: 'chk_auto_cancel_hours']
  }

  indexes {
    regency_code
    district_code
    verification_status
  }
  Note: 'GiST index on location (migration).'
}

Table farmer_verifications {
  id uuid [pk, default: `uuidv7()`]
  farmer_id uuid [not null]
  ktp_number_enc bytea [not null, note: 'Encrypted at the application layer (envelope encryption)']
  ktp_media_id uuid [not null, ref: > media_assets.id]
  land_media_id uuid [not null, ref: > media_assets.id]
  status verification_status [not null, default: 'pending']
  reviewed_by uuid [ref: > users.id]
  reviewed_at timestamptz
  rejection_reason text
  submitted_at timestamptz [not null, default: `now()`]

  indexes {
    farmer_id
    reviewed_by
    ktp_media_id
    land_media_id
    (status, submitted_at)
  }
  Note: 'History of submissions; farmer_profiles.verification_status holds the current value. Required before first payout.'
}

Table bank_accounts {
  id uuid [pk, default: `uuidv7()`]
  farmer_id uuid [not null]
  bank_code text [not null, note: 'Gateway bank code, e.g. BCA, BRI, BJB']
  account_number_enc bytea [not null]
  account_number_last4 text [not null]
  account_holder_name text [not null]
  is_primary boolean [not null, default: false]
  verified_at timestamptz [note: 'Name check via the payout provider']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    farmer_id
  }
  Note: 'Partial unique index: (farmer_id) WHERE is_primary.'
}

Table farmer_operating_hours {
  farmer_id uuid [not null]
  weekday smallint [not null, note: '0 = Sunday ... 6 = Saturday (ISO would be 1-7; pick one and keep it)']
  opens_at time [not null]
  closes_at time [not null]

  checks {
    `weekday BETWEEN 0 AND 6` [name: 'chk_weekday']
    `closes_at > opens_at` [name: 'chk_hours_order']
  }

  indexes {
    (farmer_id, weekday) [pk]
  }
}

Table farmer_holidays {
  id uuid [pk, default: `uuidv7()`]
  farmer_id uuid [not null]
  period daterange [not null, note: 'Inclusive day range of the store holiday']
  note text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    farmer_id
  }
  Note: 'PG18 temporal constraint: UNIQUE (farmer_id, period WITHOUT OVERLAPS) (needs btree_gist). Prevents overlapping holidays.'
}

Table badges {
  id uuid [pk, default: `uuidv7()`]
  code text [unique, not null, note: 'new_farmer, verified, power_farmer, fast_response, fresh_stock, on_time_harvest, surplus_hero']
  name text [not null]
  description text
  criteria jsonb [not null, default: '{}', note: 'Thresholds editable by admin, e.g. {"min_tx_month":20,"min_rating":4.7}']
  is_automatic boolean [not null, default: true]
  is_active boolean [not null, default: true]
  sort_order smallint [not null, default: 0]
}

Table farmer_badges {
  id uuid [pk, default: `uuidv7()`]
  farmer_id uuid [not null]
  badge_id uuid [not null, ref: > badges.id]
  awarded_at timestamptz [not null, default: `now()`]
  revoked_at timestamptz
  revoke_reason text
  evaluation_period date [note: 'First day of the month that was evaluated']

  indexes {
    farmer_id
    badge_id
  }
  Note: 'Partial unique index: (farmer_id, badge_id) WHERE revoked_at IS NULL. Keeps award history.'
}

// -----------------------------------------------------------------------------
// Catalog
// -----------------------------------------------------------------------------

Table categories {
  id uuid [pk, default: `uuidv7()`]
  parent_id uuid [ref: > categories.id]
  slug text [unique, not null]
  name text [not null]
  description text
  icon text [note: 'sayuran, buah, rempah, padi, umbi, jamur']
  sort_order smallint [not null, default: 0]
  is_active boolean [not null, default: true]

  indexes {
    parent_id
  }
}

Table tags {
  id uuid [pk, default: `uuidv7()`]
  slug text [unique, not null, note: 'organik, hidroponik, bebas-pestisida']
  name text [not null]
}

Table search_synonyms {
  id uuid [pk, default: `uuidv7()`]
  term text [unique, not null, note: 'Normalized (lower + unaccent), e.g. cabe, lombok, bawang beureum']
  canonical_term text [not null, note: 'e.g. cabai, bawang merah']
  source text [not null, default: 'admin', note: 'admin | regional | typo']

  indexes {
    canonical_term
  }
  Note: 'Query rewrite dictionary for fuzzy search. GIN trigram index on term (migration).'
}

Table products {
  id uuid [pk, default: `uuidv7()`]
  farmer_id uuid [not null]
  category_id uuid [not null, ref: > categories.id]
  slug text [unique, not null]
  name text [not null]
  alt_names "text[]" [not null, default: `'{}'`, note: 'Local / regional names fed into search']
  description text
  unit product_unit [not null]
  price bigint [not null, note: 'Base price per unit (IDR), tier for qty >= 1']
  min_order_qty numeric(12,3) [not null, default: 1]
  status product_status [not null, default: 'active']
  low_stock_threshold numeric(12,3)
  surplus_enabled boolean [not null, default: false]
  surplus_floor_price bigint [note: 'Minimum price after Surplus discount']
  source_waitlist_id uuid [note: 'Wait list that created this product, if any']
  search_vector tsvector [note: 'GENERATED ALWAYS AS (to_tsvector(simple, unaccent(name || alt_names || description))) STORED']
  // Denormalized read model (see documentation 4.8)
  available_qty numeric(12,3) [not null, default: 0, note: 'Sum of sellable qty across active batches']
  current_batch_id uuid [note: 'FEFO head batch: nearest expiry with stock']
  rating_avg numeric(3,2) [not null, default: 0]
  rating_count integer [not null, default: 0]
  sold_qty numeric(14,3) [not null, default: 0]
  subscriber_count integer [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  checks {
    `price > 0` [name: 'chk_price_positive']
    `min_order_qty > 0` [name: 'chk_min_order_qty']
    `surplus_floor_price IS NULL OR surplus_floor_price <= price` [name: 'chk_surplus_floor']
  }

  indexes {
    farmer_id
    category_id
    source_waitlist_id
    current_batch_id
    (status, category_id, created_at)
  }
  Note: '''
  Migration-only indexes:
  - GIN (search_vector) for full-text
  - GIN (name gin_trgm_ops) for typo-tolerant similarity
  - partial (created_at) WHERE status = 'active'
  Audit trigger writes price changes to audit_logs.
  '''
}

Table product_tags {
  product_id uuid [not null]
  tag_id uuid [not null, ref: > tags.id]

  indexes {
    (product_id, tag_id) [pk]
    tag_id
  }
}

Table price_tiers {
  id uuid [pk, default: `uuidv7()`]
  product_id uuid [not null]
  min_qty numeric(12,3) [not null, note: 'Tier applies when qty >= min_qty']
  unit_price bigint [not null]

  checks {
    `min_qty > 1` [name: 'chk_tier_above_base']
    `unit_price > 0` [name: 'chk_tier_price']
  }

  indexes {
    (product_id, min_qty) [unique]
  }
  Note: 'Wholesale tiers above the base price. Rule "higher tier = lower price" is checked by a constraint trigger.'
}

Table surplus_rules {
  id uuid [pk, default: `uuidv7()`]
  product_id uuid [not null]
  days_remaining smallint [not null, note: 'Applies when days to expiry <= this value']
  discount_pct numeric(5,2) [not null]

  checks {
    `days_remaining >= 0` [name: 'chk_days_remaining']
    `discount_pct > 0 AND discount_pct < 100` [name: 'chk_discount_pct']
  }

  indexes {
    (product_id, days_remaining) [unique]
  }
}

Table product_batches {
  id uuid [pk, default: `uuidv7()`]
  product_id uuid [not null]
  batch_no integer [not null, note: 'Per-product sequence: 1, 2, 3 ...']
  initial_qty numeric(12,3) [not null]
  on_hand_qty numeric(12,3) [not null, note: 'Physical stock for sale']
  reserved_qty numeric(12,3) [not null, default: 0, note: 'Held by unpaid checkouts / commitments']
  harvested_on date [not null]
  expires_on date [not null]
  status batch_status [not null, default: 'active']
  surplus_discount_pct numeric(5,2) [note: 'Cached current tier, refreshed by the daily surplus job']
  expired_at timestamptz
  expiry_undo_until timestamptz [note: 'Farmer may undo expiry reduction until this time (1-2 days)']
  source_waitlist_id uuid [note: 'Set when the batch comes from a wait-list harvest']
  created_by uuid [not null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]

  checks {
    `on_hand_qty >= 0` [name: 'chk_on_hand_nonneg']
    `reserved_qty >= 0 AND reserved_qty <= on_hand_qty` [name: 'chk_reserved_le_on_hand']
    `expires_on >= harvested_on` [name: 'chk_expiry_after_harvest']
  }

  indexes {
    (product_id, batch_no) [unique]
    (product_id, status, expires_on) [note: 'FEFO lookup']
    source_waitlist_id
    created_by
  }
  Note: 'Partial index (expires_on) WHERE status = active, for the nightly expiry/surplus job.'
}

Table product_photos {
  id uuid [pk, default: `uuidv7()`]
  product_id uuid [not null]
  batch_id uuid [note: 'Photo of this specific stock batch (freshness label)']
  media_id uuid [unique, not null, ref: > media_assets.id]
  caption text
  position smallint [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (product_id, position)
    batch_id
  }
}

Table stock_movements {
  id uuid [pk, default: `uuidv7()`]
  batch_id uuid [not null]
  type stock_movement_type [not null]
  qty_delta numeric(12,3) [not null, note: 'Signed change to on_hand_qty']
  reason text [note: 'Required for manual_adjustment']
  order_item_id uuid
  actor_id uuid [ref: > users.id, note: 'NULL = system job']
  created_at timestamptz [not null, default: `now()`]

  checks {
    `qty_delta <> 0` [name: 'chk_nonzero_delta']
    `type <> 'manual_adjustment' OR reason IS NOT NULL` [name: 'chk_manual_reason']
  }

  indexes {
    (batch_id, created_at)
    order_item_id
    actor_id
  }
  Note: 'Append-only. on_hand_qty = sum(qty_delta) per batch, so the cached column can be rebuilt.'
}

Table stock_reservations {
  id uuid [pk, default: `uuidv7()`]
  batch_id uuid [not null]
  order_item_id uuid [not null]
  qty numeric(12,3) [not null]
  status reservation_status [not null, default: 'active']
  expires_at timestamptz [not null, note: 'created_at + 1 hour (payment time limit)']
  created_at timestamptz [not null, default: `now()`]
  resolved_at timestamptz

  checks {
    `qty > 0` [name: 'chk_reservation_qty']
  }

  indexes {
    batch_id
    order_item_id
  }
  Note: 'Partial index (expires_at) WHERE status = active. Sweeper runs in the Node backend every minute with FOR UPDATE SKIP LOCKED. Must stay in Postgres: it commits together with product_batches.reserved_qty.'
}

Table product_subscriptions {
  user_id uuid [not null]
  product_id uuid [not null]
  on_new_stock boolean [not null, default: true]
  on_price_drop boolean [not null, default: true, note: 'Includes entering Surplus']
  on_back_in_stock boolean [not null, default: true]
  frequency notification_frequency [not null, default: 'instant']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, product_id) [pk]
    product_id [note: 'Fan-out: find subscribers of a product']
  }
}

// -----------------------------------------------------------------------------
// Wait List and Commit
// -----------------------------------------------------------------------------

Table waitlists {
  id uuid [pk, default: `uuidv7()`]
  farmer_id uuid [not null]
  category_id uuid [not null, ref: > categories.id]
  commodity_name text [not null]
  description text
  unit product_unit [not null]
  status waitlist_status [not null, default: 'planting_scheduled']
  planted_on date
  schedule_type harvest_schedule_type [not null, default: 'not_set']
  harvest_start date [note: 'exact_date: the date. date_range: first day']
  harvest_end date [note: 'date_range: last day']
  first_estimate_set_at timestamptz [note: 'Ends penalty-free cancellation for estimate-less wait lists']
  penalty_free_until timestamptz [note: 'Latest delay notification + 48 hours']
  estimated_yield_qty numeric(12,3)
  estimated_unit_price bigint [not null, note: 'Used to compute held minimum funds']
  final_unit_price bigint [note: 'Set at harvest; used for the remainder']
  quota_qty numeric(12,3) [note: 'NULL = unlimited commit']
  min_commit_qty numeric(12,3) [not null, default: 1]
  committed_min_qty numeric(12,3) [not null, default: 0, note: 'Cached sum of active commitments.qty_min']
  commitment_count integer [not null, default: 0]
  follower_count integer [not null, default: 0]
  actual_harvest_qty numeric(12,3)
  product_id uuid [ref: - products.id, note: 'Product opened for sale after harvest']
  failure_reason text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  checks {
    `(schedule_type = 'not_set' AND harvest_start IS NULL AND harvest_end IS NULL) OR (schedule_type = 'exact_date' AND harvest_start IS NOT NULL AND harvest_end IS NULL) OR (schedule_type = 'date_range' AND harvest_start IS NOT NULL AND harvest_end > harvest_start)` [name: 'chk_schedule_shape']
    `quota_qty IS NULL OR committed_min_qty <= quota_qty` [name: 'chk_quota_not_exceeded']
    `status <> 'harvest_failed' OR failure_reason IS NOT NULL` [name: 'chk_failed_reason']
  }

  indexes {
    farmer_id
    category_id
    product_id
    (status, harvest_start)
  }
}

Table waitlist_events {
  id uuid [pk, default: `uuidv7()`]
  waitlist_id uuid [not null]
  type waitlist_event_type [not null]
  from_status waitlist_status
  to_status waitlist_status
  old_schedule jsonb [note: '{type, start, end} before the change']
  new_schedule jsonb
  title text [not null]
  body text
  reason text [note: 'Required for harvest_delayed and harvest_failed']
  created_by uuid [not null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]

  checks {
    `to_status IS NULL OR to_status NOT IN ('harvest_delayed', 'harvest_failed') OR reason IS NOT NULL` [name: 'chk_reason_required']
  }

  indexes {
    (waitlist_id, created_at)
    created_by
  }
  Note: 'Append-only public timeline shown to buyers.'
}

Table waitlist_media {
  id uuid [pk, default: `uuidv7()`]
  event_id uuid [not null]
  media_id uuid [unique, not null, ref: > media_assets.id]
  caption text
  position smallint [not null, default: 0]

  indexes {
    event_id
  }
}

Table waitlist_followers {
  user_id uuid [not null]
  waitlist_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, waitlist_id) [pk]
    waitlist_id
  }
}

Table commitments {
  id uuid [pk, default: `uuidv7()`]
  waitlist_id uuid [not null]
  buyer_id uuid [not null]
  qty_min numeric(12,3) [not null]
  qty_max numeric(12,3) [not null]
  unit_price_estimate bigint [not null, note: 'Snapshot of waitlists.estimated_unit_price']
  held_amount bigint [not null, note: 'qty_min * unit_price_estimate, held in escrow']
  had_estimate_at_commit boolean [not null, note: 'Shown the "no schedule certainty" warning if false']
  status commitment_status [not null, default: 'active']
  allocated_qty numeric(12,3)
  remainder_amount bigint
  remainder_due_at timestamptz [note: 'Harvest available + 48 hours']
  remainder_paid_at timestamptz [note: 'Allocation priority when harvest is short: earliest payer first']
  penalty_amount bigint [not null, default: 0, note: '20% of held_amount when applicable']
  cancelled_at timestamptz
  cancel_reason text
  order_id uuid [note: 'Order created at allocation']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  checks {
    `qty_min > 0 AND qty_max >= qty_min` [name: 'chk_commit_range']
    `allocated_qty IS NULL OR allocated_qty <= qty_max` [name: 'chk_allocated_le_max']
    `penalty_amount >= 0 AND penalty_amount <= held_amount` [name: 'chk_penalty_bounds']
  }

  indexes {
    waitlist_id
    buyer_id
    order_id
    (waitlist_id, status, remainder_paid_at) [note: 'Allocation order']
  }
  Note: 'Partial index (remainder_due_at) WHERE status = awaiting_remainder for the 48-hour job.'
}

// -----------------------------------------------------------------------------
// Carts (Temporary Cart and Recipe Cart)
// -----------------------------------------------------------------------------

Table carts {
  id uuid [pk, default: `uuidv7()`]
  buyer_id uuid [not null]
  kind cart_kind [not null]
  name text [note: 'Required for recipe carts, e.g. Nasi Goreng']
  note text
  last_checkout_at timestamptz
  checkout_count integer [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  checks {
    `kind = 'temporary' OR name IS NOT NULL` [name: 'chk_recipe_name']
  }

  indexes {
    (buyer_id, kind)
  }
  Note: 'Partial unique index: (buyer_id) WHERE kind = temporary (one temporary cart per buyer).'
}

Table cart_items {
  id uuid [pk, default: `uuidv7()`]
  cart_id uuid [not null]
  product_id uuid [ref: > products.id]
  waitlist_id uuid [ref: > waitlists.id, note: 'Recipe item that checks out as a Commit']
  quantity numeric(12,3) [not null]
  position smallint [not null, default: 0]
  added_at timestamptz [not null, default: `now()`]

  checks {
    `num_nonnulls(product_id, waitlist_id) = 1` [name: 'chk_item_target']
    `quantity > 0` [name: 'chk_item_qty']
  }

  indexes {
    cart_id
    product_id
    waitlist_id
    (cart_id, product_id) [unique]
    (cart_id, waitlist_id) [unique]
  }
  Note: 'Adding to cart does not reserve stock.'
}

Table cart_item_alternatives {
  id uuid [pk, default: `uuidv7()`]
  cart_item_id uuid [not null]
  product_id uuid [not null, ref: > products.id]
  priority smallint [not null, note: '1 = first alternative; reordered by drag and drop']

  checks {
    `priority >= 1` [name: 'chk_priority']
  }

  indexes {
    (cart_item_id, priority) [unique, note: 'DEFERRABLE INITIALLY DEFERRED so a reorder can swap rows in one transaction']
    (cart_item_id, product_id) [unique]
    product_id
  }
  Note: 'Uses the primary item quantity. Substitutions apply per checkout only.'
}

// -----------------------------------------------------------------------------
// Orders and fulfilment
// -----------------------------------------------------------------------------

Table platform_fee_settings {
  id uuid [pk, default: `uuidv7()`]
  commission_pct numeric(5,2) [not null, note: 'Charged to the farmer']
  service_fee_pct numeric(5,2) [not null, note: 'Charged to the buyer']
  penalty_platform_share_pct numeric(5,2) [not null, default: 20]
  effective_from timestamptz [not null]
  created_by uuid [not null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]

  checks {
    `commission_pct BETWEEN 0 AND 5` [name: 'chk_commission_max']
    `service_fee_pct BETWEEN 0 AND 2` [name: 'chk_service_fee_max']
    `penalty_platform_share_pct BETWEEN 0 AND 100` [name: 'chk_penalty_share']
  }

  indexes {
    effective_from [unique]
    created_by
  }
  Note: 'Versioned: the active row is the latest effective_from <= now(). Orders snapshot the rates.'
}

Table checkouts {
  id uuid [pk, default: `uuidv7()`]
  buyer_id uuid [not null]
  source_cart_id uuid [ref: > carts.id, note: 'Recipe Cart analytics']
  address_id uuid [ref: > addresses.id]
  address_snapshot jsonb [note: 'Frozen copy of the address at checkout']
  goods_total bigint [not null]
  shipping_total bigint [not null, default: 0]
  service_fee_total bigint [not null, default: 0]
  grand_total bigint [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    buyer_id
    source_cart_id
    address_id
  }
  Note: 'One buyer action -> one payment -> one order per farmer.'
}

Table orders {
  id uuid [pk, default: `uuidv7()`]
  code text [unique, not null, note: 'Human-readable, e.g. PT-20261104-8F3K']
  checkout_id uuid [ref: > checkouts.id, note: 'NULL for orders created from a commitment']
  buyer_id uuid [not null]
  farmer_id uuid [not null]
  status order_status [not null, default: 'awaiting_payment']
  escrow_status escrow_status [not null, default: 'not_funded']
  goods_subtotal bigint [not null, note: 'After tier and Surplus discounts, before fees']
  shipping_fee bigint [not null, default: 0]
  service_fee bigint [not null, default: 0]
  commission_fee bigint [not null, default: 0]
  buyer_total bigint [not null, note: 'goods_subtotal + shipping_fee + service_fee']
  farmer_net bigint [not null, note: 'goods_subtotal + shipping (self delivery) - commission_fee']
  commission_pct numeric(5,2) [not null, note: 'Snapshot']
  service_fee_pct numeric(5,2) [not null, note: 'Snapshot']
  fee_setting_id uuid [not null, ref: > platform_fee_settings.id]
  payment_due_at timestamptz [note: 'Created + 1 hour']
  respond_by timestamptz [note: 'Auto-cancel deadline when the farmer enabled it']
  confirmed_at timestamptz
  completed_at timestamptz
  cancelled_at timestamptz
  cancel_reason text
  cancelled_by uuid [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  checks {
    `buyer_total = goods_subtotal + shipping_fee + service_fee` [name: 'chk_buyer_total']
  }

  indexes {
    checkout_id
    (buyer_id, created_at)
    (farmer_id, status, created_at)
    fee_setting_id
    cancelled_by
  }
  Note: 'Partial indexes for jobs: (payment_due_at) WHERE status = awaiting_payment; (respond_by) WHERE status = confirmed.'
}

Table order_items {
  id uuid [pk, default: `uuidv7()`]
  order_id uuid [not null]
  product_id uuid [not null, ref: > products.id]
  source order_item_source [not null, default: 'direct']
  commitment_id uuid [ref: > commitments.id]
  substituted_for_product_id uuid [ref: > products.id, note: 'Recipe Cart alternative used at checkout']
  product_name text [not null, note: 'Snapshot']
  unit product_unit [not null, note: 'Snapshot']
  quantity numeric(12,3) [not null]
  tier_unit_price bigint [not null, note: 'Price after wholesale tier, before Surplus']
  line_subtotal bigint [not null, note: 'Sum of allocations.line_amount']

  checks {
    `quantity > 0` [name: 'chk_order_item_qty']
  }

  indexes {
    order_id
    product_id
    commitment_id
    substituted_for_product_id
  }
}

Table order_item_allocations {
  id uuid [pk, default: `uuidv7()`]
  order_item_id uuid [not null]
  batch_id uuid [not null, ref: > product_batches.id]
  qty numeric(12,3) [not null]
  unit_price bigint [not null, note: 'May differ per batch because Surplus is per batch']
  surplus_discount_pct numeric(5,2)
  line_amount bigint [not null]

  indexes {
    order_item_id
    batch_id
  }
  Note: 'FEFO split: one item can be served by several batches.'
}

Table order_status_history {
  id uuid [pk, default: `uuidv7()`]
  order_id uuid [not null]
  from_status order_status
  to_status order_status [not null]
  actor_id uuid [ref: > users.id, note: 'NULL = system']
  note text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (order_id, created_at)
    actor_id
  }
}

Table shipments {
  id uuid [pk, default: `uuidv7()`]
  order_id uuid [unique, not null]
  method delivery_method [not null]
  courier_code text [note: 'Aggregator courier/service code']
  courier_service text
  tracking_number text
  weight_grams integer
  distance_km numeric(7,2)
  shipping_fee bigint [not null, default: 0]
  scheduled_for timestamptz [note: 'Delivery scheduling (needs evaluation)']
  shipped_at timestamptz
  arrived_at timestamptz [note: 'Starts the 3-day complaint / auto-release window']
  received_confirmed_at timestamptz
  auto_release_at timestamptz [note: 'arrived_at + 3 days; paused while a complaint is open']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    tracking_number
  }
  Note: 'Partial index (auto_release_at) WHERE received_confirmed_at IS NULL.'
}

// -----------------------------------------------------------------------------
// Payments, escrow ledger, refunds, payouts
// -----------------------------------------------------------------------------

Table payments {
  id uuid [pk, default: `uuidv7()`]
  payer_id uuid [not null, ref: > users.id]
  purpose payment_purpose [not null]
  checkout_id uuid [ref: > checkouts.id]
  commitment_id uuid [ref: > commitments.id]
  method payment_method [not null]
  provider text [not null, note: 'Gateway name, e.g. midtrans or xendit']
  provider_ref text [note: 'Gateway transaction id']
  idempotency_key text [unique, not null]
  amount bigint [not null]
  status payment_status [not null, default: 'pending']
  va_bank text
  va_number text
  qr_string text
  expires_at timestamptz [not null]
  paid_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  checks {
    `num_nonnulls(checkout_id, commitment_id) = 1` [name: 'chk_payment_target']
    `amount > 0` [name: 'chk_payment_amount']
  }

  indexes {
    (provider, provider_ref) [unique]
    payer_id
    checkout_id
    commitment_id
  }
}

Table payment_webhook_events {
  id uuid [pk, default: `uuidv7()`]
  provider text [not null]
  provider_event_id text [not null]
  event_type text [not null]
  payload jsonb [not null]
  signature_valid boolean [not null]
  received_at timestamptz [not null, default: `now()`]
  processed_at timestamptz
  error text

  indexes {
    (provider, provider_event_id) [unique, note: 'Inbox dedupe: replays are ignored']
  }
}

Table ledger_accounts {
  id uuid [pk, default: `uuidv7()`]
  owner_id uuid [ref: > users.id, note: 'NULL for platform system accounts']
  type ledger_account_type [not null]
  balance bigint [not null, default: 0, note: 'Cached; equals the sum of entries']
  created_at timestamptz [not null, default: `now()`]

  checks {
    `type NOT IN ('buyer_wallet', 'farmer_balance') OR balance >= 0` [name: 'chk_no_negative_wallet']
  }

  indexes {
    (owner_id, type) [unique, note: 'NULLS NOT DISTINCT so each system account exists once']
  }
}

Table ledger_transactions {
  id uuid [pk, default: `uuidv7()`]
  kind ledger_txn_kind [not null]
  description text
  order_id uuid [ref: > orders.id]
  commitment_id uuid [ref: > commitments.id]
  payment_id uuid [ref: > payments.id]
  refund_id uuid [ref: > refunds.id]
  payout_id uuid [ref: > payouts.id]
  idempotency_key text [unique, not null, note: 'e.g. release:order:<id>']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    order_id
    commitment_id
    payment_id
    refund_id
    payout_id
  }
}

Table ledger_entries {
  id uuid [pk, default: `uuidv7()`]
  transaction_id uuid [not null]
  account_id uuid [not null, ref: > ledger_accounts.id]
  amount bigint [not null, note: 'Signed: + credit to the account, - debit']
  created_at timestamptz [not null, default: `now()`]

  checks {
    `amount <> 0` [name: 'chk_entry_nonzero']
  }

  indexes {
    transaction_id
    (account_id, created_at)
  }
  Note: 'Append-only. Deferred constraint trigger: SUM(amount) per transaction_id = 0 (double entry).'
}

Table refunds {
  id uuid [pk, default: `uuidv7()`]
  order_id uuid [ref: > orders.id]
  commitment_id uuid [ref: > commitments.id]
  complaint_id uuid [ref: > complaints.id]
  amount bigint [not null]
  reason text [not null]
  to_wallet boolean [not null, default: true, note: 'MVP refunds go to the platform wallet']
  status refund_status [not null, default: 'pending']
  approved_by uuid [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  completed_at timestamptz

  checks {
    `num_nonnulls(order_id, commitment_id) = 1` [name: 'chk_refund_target']
    `amount > 0` [name: 'chk_refund_amount']
  }

  indexes {
    order_id
    commitment_id
    complaint_id
    approved_by
  }
}

Table payouts {
  id uuid [pk, default: `uuidv7()`]
  farmer_id uuid [not null]
  bank_account_id uuid [not null, ref: > bank_accounts.id]
  amount bigint [not null]
  status payout_status [not null, default: 'requested']
  provider_ref text
  failure_reason text
  requested_at timestamptz [not null, default: `now()`]
  completed_at timestamptz

  checks {
    `amount > 0` [name: 'chk_payout_amount']
  }

  indexes {
    (farmer_id, requested_at)
    bank_account_id
  }
  Note: 'Service layer blocks payouts until farmer verification is approved.'
}

// -----------------------------------------------------------------------------
// Reviews, complaints, reports
// -----------------------------------------------------------------------------

Table reviews {
  id uuid [pk, default: `uuidv7()`]
  order_item_id uuid [unique, not null, note: 'One review per purchased item; only after receipt']
  product_id uuid [not null]
  farmer_id uuid [not null]
  buyer_id uuid [not null]
  rating smallint [not null]
  comment text
  status moderation_status [not null, default: 'published']
  reply_body text [note: 'Farmer reply']
  replied_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  checks {
    `rating BETWEEN 1 AND 5` [name: 'chk_rating']
  }

  indexes {
    (product_id, created_at)
    (farmer_id, created_at)
    buyer_id
  }
}

Table review_photos {
  id uuid [pk, default: `uuidv7()`]
  review_id uuid [not null]
  media_id uuid [unique, not null, ref: > media_assets.id]
  position smallint [not null, default: 0]

  indexes {
    review_id
  }
}

Table complaints {
  id uuid [pk, default: `uuidv7()`]
  order_id uuid [not null]
  buyer_id uuid [not null, ref: > users.id]
  reason complaint_reason [not null]
  description text [not null]
  status complaint_status [not null, default: 'open']
  requested_amount bigint
  resolved_amount bigint
  mediator_id uuid [ref: > users.id, note: 'Admin handling the dispute']
  resolution_note text
  opened_at timestamptz [not null, default: `now()`]
  resolved_at timestamptz

  indexes {
    order_id
    buyer_id
    mediator_id
    (status, opened_at)
  }
  Note: 'Allowed only within 3 days of shipments.arrived_at (service rule). Opening sets orders.escrow_status = disputed.'
}

Table complaint_evidence {
  id uuid [pk, default: `uuidv7()`]
  complaint_id uuid [not null]
  media_id uuid [unique, not null, ref: > media_assets.id, note: 'Uploader and time are on media_assets']

  indexes {
    complaint_id
  }
}

Table complaint_messages {
  id uuid [pk, default: `uuidv7()`]
  complaint_id uuid [not null]
  sender_id uuid [not null, ref: > users.id]
  body text [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (complaint_id, created_at)
    sender_id
  }
  Note: 'Three-way mediation thread (buyer, farmer, admin).'
}

Table reports {
  id uuid [pk, default: `uuidv7()`]
  reporter_id uuid [not null, ref: > users.id]
  product_id uuid [ref: > products.id]
  farmer_id uuid [ref: > farmer_profiles.user_id]
  review_id uuid [ref: > reviews.id]
  reason text [not null]
  details text
  status report_status [not null, default: 'open']
  handled_by uuid [ref: > users.id]
  handled_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  checks {
    `num_nonnulls(product_id, farmer_id, review_id) = 1` [name: 'chk_report_target']
  }

  indexes {
    reporter_id
    product_id
    farmer_id
    review_id
    handled_by
    (status, created_at)
  }
}

// -----------------------------------------------------------------------------
// Chat and notifications
// -----------------------------------------------------------------------------

Table conversations {
  id uuid [pk, default: `uuidv7()`]
  buyer_id uuid [not null, ref: > users.id]
  farmer_id uuid [not null, ref: > farmer_profiles.user_id]
  last_message_at timestamptz
  buyer_last_read_at timestamptz
  farmer_last_read_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (buyer_id, farmer_id) [unique]
    (farmer_id, last_message_at)
    (buyer_id, last_message_at)
  }
}

Table messages {
  id uuid [pk, default: `uuidv7()`]
  conversation_id uuid [not null]
  sender_id uuid [not null, ref: > users.id]
  client_message_id uuid [not null, note: 'Generated by the client; makes WebSocket resends idempotent']
  body text
  attachment_media_id uuid [ref: > media_assets.id]
  product_id uuid [ref: > products.id, note: 'Optional product card in the message']
  created_at timestamptz [not null, default: `now()`]

  checks {
    `body IS NOT NULL OR attachment_media_id IS NOT NULL` [name: 'chk_message_content']
  }

  indexes {
    (conversation_id, id) [note: 'uuidv7 is time-ordered: reconnect resumes with WHERE id > last_seen_id']
    (sender_id, client_message_id) [unique]
    attachment_media_id
    product_id
  }
  Note: 'Written to Postgres first, then published to Redis pub/sub for WebSocket fan-out.'
}

Table notifications {
  id uuid [pk, default: `uuidv7()`]
  user_id uuid [not null]
  category notification_category [not null]
  type text [not null, note: 'e.g. waitlist.schedule_changed, product.back_in_stock']
  title text [not null]
  body text
  link text [note: 'Frontend path, e.g. /pesanan/<id>']
  data jsonb [not null, default: '{}']
  read_at timestamptz
  pushed_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, created_at)
  }
  Note: 'Partial index (user_id) WHERE read_at IS NULL for the unread badge.'
}

Table outbox_events {
  id uuid [pk, default: `uuidv7()`]
  aggregate_type text [not null, note: 'order, waitlist, product, ...']
  aggregate_id uuid [not null]
  event_type text [not null]
  payload jsonb [not null]
  created_at timestamptz [not null, default: `now()`]
  available_at timestamptz [not null, default: `now()`, note: 'For retries with backoff']
  processed_at timestamptz
  attempts smallint [not null, default: 0]
  last_error text

  indexes {
    (aggregate_type, aggregate_id)
  }
  Note: 'Transactional outbox. Partial index (available_at) WHERE processed_at IS NULL; Node workers claim rows with FOR UPDATE SKIP LOCKED, then write notifications, send web push and publish to Redis for live WebSocket delivery.'
}

// -----------------------------------------------------------------------------
// Analytics, audit, settings
// -----------------------------------------------------------------------------

Table product_daily_stats {
  product_id uuid [not null]
  day date [not null]
  views integer [not null, default: 0]
  add_to_carts integer [not null, default: 0]
  subscriptions integer [not null, default: 0]
  purchases integer [not null, default: 0]
  units_sold numeric(14,3) [not null, default: 0]
  revenue bigint [not null, default: 0]

  indexes {
    (product_id, day) [pk]
    day
  }
  Note: '''
  views and add_to_carts: counted in Redis during the day
  (HINCRBY stats:{yyyymmdd}:{product_id}, PFADD for unique viewers) and flushed here nightly.
  subscriptions, purchases, units_sold, revenue: aggregated from Postgres tables.
  Feeds the farmer funnel and best/slow sellers.
  '''
}

Table audit_logs {
  id uuid [not null, default: `uuidv7()`]
  created_at timestamptz [not null, default: `now()`]
  actor_id uuid [note: 'NULL = system']
  action text [not null, note: 'e.g. product.price_changed, order.status_changed, fee.updated']
  entity_type text [not null]
  entity_id uuid [not null]
  old_values jsonb
  new_values jsonb
  ip_address inet

  indexes {
    (id, created_at) [pk]
    (entity_type, entity_id, created_at)
    actor_id
  }
  Note: 'PARTITION BY RANGE (created_at), monthly. Append-only (app role has INSERT only). Written by triggers on price and status columns.'
}

Table platform_settings {
  key text [pk, note: 'e.g. payment_timeout_minutes, remainder_window_hours, complaint_window_days']
  value jsonb [not null]
  updated_by uuid [ref: > users.id]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    updated_by
  }
}

// -----------------------------------------------------------------------------
// Relationships with referential actions (inline refs cannot carry settings)
// -----------------------------------------------------------------------------

// Identity
Ref: neon_auth.user.id - users.id [delete: restrict]
Ref: users.avatar_media_id > media_assets.id [delete: set null]
Ref: addresses.user_id > users.id [delete: cascade]
Ref: notification_preferences.user_id > users.id [delete: cascade]
Ref: push_subscriptions.user_id > users.id [delete: cascade]
Ref: users.id - farmer_profiles.user_id [delete: cascade]
Ref: farmer_verifications.farmer_id > farmer_profiles.user_id [delete: cascade]
Ref: bank_accounts.farmer_id > farmer_profiles.user_id [delete: restrict]
Ref: farmer_operating_hours.farmer_id > farmer_profiles.user_id [delete: cascade]
Ref: farmer_holidays.farmer_id > farmer_profiles.user_id [delete: cascade]
Ref: farmer_badges.farmer_id > farmer_profiles.user_id [delete: cascade]

// Catalog
Ref: products.farmer_id > farmer_profiles.user_id [delete: restrict]
Ref: products.source_waitlist_id > waitlists.id [delete: set null]
Ref: products.current_batch_id > product_batches.id [delete: set null]
Ref: product_tags.product_id > products.id [delete: cascade]
Ref: price_tiers.product_id > products.id [delete: cascade]
Ref: surplus_rules.product_id > products.id [delete: cascade]
Ref: product_batches.product_id > products.id [delete: restrict]
Ref: product_batches.source_waitlist_id > waitlists.id [delete: set null]
Ref: product_photos.product_id > products.id [delete: cascade]
Ref: product_photos.batch_id > product_batches.id [delete: set null]
Ref: stock_movements.batch_id > product_batches.id [delete: restrict]
Ref: stock_movements.order_item_id > order_items.id [delete: restrict]
Ref: stock_reservations.batch_id > product_batches.id [delete: restrict]
Ref: stock_reservations.order_item_id > order_items.id [delete: cascade]
Ref: product_subscriptions.user_id > users.id [delete: cascade]
Ref: product_subscriptions.product_id > products.id [delete: cascade]

// Wait list
Ref: waitlists.farmer_id > farmer_profiles.user_id [delete: restrict]
Ref: waitlist_events.waitlist_id > waitlists.id [delete: cascade]
Ref: waitlist_media.event_id > waitlist_events.id [delete: cascade]
Ref: waitlist_followers.user_id > users.id [delete: cascade]
Ref: waitlist_followers.waitlist_id > waitlists.id [delete: cascade]
Ref: commitments.waitlist_id > waitlists.id [delete: restrict]
Ref: commitments.buyer_id > users.id [delete: restrict]
Ref: commitments.order_id > orders.id [delete: set null]

// Carts
Ref: carts.buyer_id > users.id [delete: cascade]
Ref: cart_items.cart_id > carts.id [delete: cascade]
Ref: cart_item_alternatives.cart_item_id > cart_items.id [delete: cascade]

// Orders
Ref: checkouts.buyer_id > users.id [delete: restrict]
Ref: orders.buyer_id > users.id [delete: restrict]
Ref: orders.farmer_id > farmer_profiles.user_id [delete: restrict]
Ref: order_items.order_id > orders.id [delete: cascade]
Ref: order_item_allocations.order_item_id > order_items.id [delete: cascade]
Ref: order_status_history.order_id > orders.id [delete: cascade]
Ref: orders.id - shipments.order_id [delete: cascade]

// Ledger and money
Ref: ledger_entries.transaction_id > ledger_transactions.id [delete: restrict]
Ref: payouts.farmer_id > farmer_profiles.user_id [delete: restrict]

// Reviews, complaints
Ref: order_items.id - reviews.order_item_id [delete: restrict]
Ref: reviews.product_id > products.id [delete: cascade]
Ref: reviews.farmer_id > farmer_profiles.user_id [delete: cascade]
Ref: reviews.buyer_id > users.id [delete: restrict]
Ref: review_photos.review_id > reviews.id [delete: cascade]
Ref: complaints.order_id > orders.id [delete: restrict]
Ref: complaint_evidence.complaint_id > complaints.id [delete: cascade]
Ref: complaint_messages.complaint_id > complaints.id [delete: cascade]

// Chat, notifications
Ref: messages.conversation_id > conversations.id [delete: cascade]
Ref: notifications.user_id > users.id [delete: cascade]

// Analytics
Ref: product_daily_stats.product_id > products.id [delete: cascade]

